# Copy this file to .env and adjust as needed.
# Since the tool is meant to be cloned and run locally (no hosting),
# SQLite is the default DB -- zero setup required.
DATABASE_URL=sqlite:///./recon_mapper.db

# Per-tool timeouts, in seconds. Raise these for large targets.
SUBFINDER_TIMEOUT=120
AMASS_TIMEOUT=300
HTTPX_TIMEOUT=180
GAU_TIMEOUT=120
NUCLEI_TIMEOUT=900
